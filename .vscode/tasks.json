{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build release",
            "type": "shell",
            "command": "scons",
            "problemMatcher": [],
            "args": ["-j12"],
            "group": {
                "kind": "build",
            },
            "options": {
                "cwd": "${workspaceFolder}/build",
            }
        },
        {
            "label": "build debug",
            "type": "shell",
            "command": "scons",
            "problemMatcher": [],
            "args": ["-j12", "target=template_debug", "debug_symbols=yes"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "options": {
                "cwd": "${workspaceFolder}/build",
            }
        }
    ]
}