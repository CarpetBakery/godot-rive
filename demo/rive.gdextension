[configuration]

entry_symbol = "rive_library_init"
compatibility_minimum = 4.1

[libraries]

macos.debug = "bin/librive.macos.template_debug.framework"
macos.release = "bin/librive.macos.template_release.framework"
windows.debug.x86_32 = "res://bin/librive.windows.template_debug.x86_32.dll"
windows.release.x86_32 = "res://bin/librive.windows.template_release.x86_32.dll"
windows.debug.x86_64 = "res://bin/librive.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/librive.windows.template_release.x86_64.dll"


[icons]

RiveViewer = "icons/rive_viewer_icon.svg"
RiveViewer2D = "icons/rive_viewer_2d_icon.svg"